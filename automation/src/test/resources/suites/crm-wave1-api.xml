<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- CRM go-live Wave 1 (access and security), API part: ONE JVM, classes one after another (several change the same
     users), one API sign-in per account. SessionPolicyTest is last: it lowers tenant session limits for a few minutes.
     mvnw test -Dsuite=crm-wave1-api -->
<suite name="CRM go-live wave 1 API" verbose="1" preserve-order="true">
    <test name="wave1-api" preserve-order="true">
        <classes>
            <class name="qa.features.crmaccess.AdminApiTest"/>
            <class name="qa.features.crmaccess.TeamspaceAccessTest"/>
            <class name="qa.features.crmaccess.FieldPermissionTest">
                <methods><include name="effectiveShowsRestrictions"/></methods>
            </class>
            <class name="qa.features.crmaccess.UsersProfilesTest">
                <methods><include name="profileLifecycle"/></methods>
            </class>
            <class name="qa.features.crmaccess.SessionPolicyTest"/>
        </classes>
    </test>
</suite>
