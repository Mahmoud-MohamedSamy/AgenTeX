<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- CRM go-live Wave 5 (setup and integrations), parallel-safe part: everything runs on modules the classes create
     themselves ("QA W5 Auto/UI …") and is deleted afterwards. ONE JVM, one owner sign-in.
     mvnw test -Dsuite=crm-wave5   (screen class needs the -Dbase.url / -Dcredentials.* flags in feature-map.md) -->
<suite name="CRM go-live wave 5" verbose="1" preserve-order="true">
    <test name="wave5-api" preserve-order="true">
        <classes>
            <class name="qa.features.crmsetup.SetupApiTest"/>
        </classes>
    </test>
</suite>
