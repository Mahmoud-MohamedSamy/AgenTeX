<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- CRM Automation Execution Order: every group class in ONE JVM, classes in parallel (each class = one session with its own
     "QA AEO <tag>" prefix and QA layouts). One API sign-in per account for the whole run (sign-ins are rate-limited).
     mvnw test -Dsuite=crm-order [-Dtags=group-f] [-Dcases=F-07] -->
<suite name="CRM automation execution order" verbose="1" parallel="classes" thread-count="3">
    <test name="crm-order">
        <packages>
            <package name="qa.features.crmautomationorder"/>
        </packages>
    </test>
</suite>
