<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- CRM go-live round 2, Wave 4 (27 Oct 2026): one JVM, so one sign-in per account (owner, test user 1). Leaves out
     smsTemplate (an archived SMS template can't be deleted) and telephonyStatus (telephony skipped by the user).
     reminderBeforeDelivered waits up to ~6 minutes. mvnw test -Dsuite=crm-wave4-r2 -->
<suite name="CRM go-live round 2 wave 4" verbose="1" preserve-order="true">
    <test name="wave4-r2" preserve-order="true">
        <classes>
            <class name="qa.features.crmchannels.ChannelsApiTest">
                <methods>
                    <include name="draftsAndScheduled"/>
                    <include name="templateLifecycle"/>
                    <include name="unknownPlaceholderNotSilent"/>
                    <include name="webFormHostedLink"/>
                    <include name="portalLinkOpens"/>
                    <include name="notificationsAnswer"/>
                </methods>
            </class>
            <class name="qa.features.crmchannels.R2W4ChannelsTest"/>
        </classes>
    </test>
</suite>
