<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Framework self-test: proves self-healing on a local page (no app, no login). mvnw test -Dsuite=selftest -->
<suite name="Framework self-test" verbose="1">
    <test name="self-healing">
        <classes>
            <class name="qa.framework.SelfHealingSelfTest"/>
        </classes>
    </test>
</suite>
