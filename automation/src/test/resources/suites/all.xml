<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Every feature. Narrow with -Dfeature=<name>, -Dtags=smoke,NDC-1234, -Dcases=WFR-001 (see TagFilter). -->
<suite name="All features" verbose="1" parallel="classes" thread-count="1">
    <test name="features">
        <packages>
            <package name="qa.features.*"/>
        </packages>
    </test>
</suite>
