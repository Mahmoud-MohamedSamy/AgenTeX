{
  "RecordScreensPage": {
    "byText": {
      "description": "Visible button, tab, link or menu item with the exact text {0}",
      "candidates": [
        { "by": "xpath", "value": "//*[self::button or @role='tab' or @role='menuitem' or self::a][normalize-space(.)='{0}']" },
        { "by": "xpath", "value": "//*[normalize-space(text())='{0}']" },
        { "by": "role", "value": "button", "name": "{0}", "exact": true }
      ]
    },
    "activityButton": {
      "description": "Record page activity quick-create button '+ {0}' (Task, Call, Meeting)",
      "candidates": [
        { "by": "xpath", "value": "//button[normalize-space(.)='+ {0}' or normalize-space(.)='+{0}']" },
        { "by": "xpath", "value": "//button[contains(normalize-space(.), '{0}') and string-length(normalize-space(.)) <= string-length('{0}') + 2]" },
        { "by": "role", "value": "button", "name": "+ {0}", "exact": false }
      ]
    },
    "listRow": {
      "description": "First data row of a module list (a row with a record link)",
      "candidates": [
        { "by": "css", "value": "tbody tr a[href*='/records/']" },
        { "by": "css", "value": "[role=row] a[href*='/records/']" },
        { "by": "css", "value": "tbody tr td" }
      ]
    }
  }
}
