{
  "AccessScreensPage" : {
    "byText" : {
      "description" : "Visible button, tab, link or menu item with the exact text {0}",
      "candidates" : [ {
        "by" : "xpath",
        "value" : "//*[self::button or @role='tab' or @role='menuitem' or @role='option' or self::a][normalize-space(.)='{0}']"
      }, {
        "by" : "role",
        "value" : "button",
        "name" : "{0}",
        "exact" : true
      }, {
        "by" : "xpath",
        "value" : "//*[normalize-space(text())='{0}']"
      } ]
    },
    "searchBox" : {
      "description" : "First visible search input of the screen (placeholder starts with Search)",
      "candidates" : [ {
        "by" : "css",
        "value" : "main input[placeholder^='Search']"
      }, {
        "by" : "css",
        "value" : "input[type='search']"
      }, {
        "by" : "xpath",
        "value" : "//input[contains(@placeholder,'Search') and not(ancestor::nav)]"
      } ]
    }
  }
